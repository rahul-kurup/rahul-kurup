# Public/config vars are inlined into the client bundle at build time.
# Provide them in the environment before `vite build` (or in `.env` /
# mode-specific files such as `.env.test` and `.env.production`).

# enable visitor email + tracking (set to 1 in production)
VITE_LIVE=0

# reCAPTCHA
VITE_RECAPTCHA_SITE_KEY=
# Microsoft Clarity ID
VITE_TRACK_MSFT_CLARITY=
# Google Analytics ID
VITE_TRACK_GGL_ANALYTICS=
# Google Tag Manager ID
VITE_TRACK_GGL_TAG_MANAGER=