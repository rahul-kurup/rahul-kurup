{
  "name": "rahulkurup.com",
  "description": "my portfolio website",
  "author": {
    "name": "Rahul Kurup",
    "email": "rahul.kurup@hotmail.com",
    "url": "https://rahulkurup.com"
  },
  "private": true,
  "type": "module",
  "version": "0.4.0",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "start": "vite preview",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "pretty": "prettier --log-level=error --write .",
    "secrets:test": "wrangler versions secret bulk .dev.vars.test -e test",
    "secrets:prod": "wrangler versions secret bulk .dev.vars.prod -e production",
    "deploy:test": "vite build --mode test && wrangler deploy -e test",
    "deploy:prod": "vite build --mode production && wrangler deploy -e production",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv ./cloudflare-env.d.ts"
  },
  "dependencies": {
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/server": "^11.11.0",
    "@emotion/styled": "^11.14.1",
    "@fontsource-variable/recursive": "^5.3.0",
    "@fontsource/pt-sans": "^5.3.0",
    "@tanstack/react-router": "^1.170.32",
    "@tanstack/react-start": "^1.168.49",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.54.4",
    "@cloudflare/workers-types": "^4.20260702.1",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "wrangler": "^4.129.0"
  },
  "overrides": {
    "cookie": "^1.1.1",
    "fast-xml-parser": "^5.7.3",
    "postcss": "^8.5.10"
  },
  "resolutions": {
    "cookie": "^1.1.1",
    "fast-xml-parser": "^5.7.3",
    "postcss": "^8.5.10"
  },
  "engines": {
    "node": "24"
  }
}
