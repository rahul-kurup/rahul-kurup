{
  "name": "rahulkurup.com",
  "description": "my portfolio website",
  "author": {
    "name": "Rahul Kurup",
    "email": "rahul.kurup@hotmail.com",
    "url": "https://rahulkurup.com"
  },
  "private": true,
  "type": "module",
  "version": "0.4.0",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "start": "vite preview",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "pretty": "prettier --log-level=error --write .",
    "secrets:test": "wrangler versions secret bulk .dev.vars.test -e test",
    "secrets:prod": "wrangler versions secret bulk .dev.vars.prod -e production",
    "deploy:test": "vite build --mode test && wrangler deploy -e test",
    "deploy:prod": "vite build --mode production && wrangler deploy -e production",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv ./cloudflare-env.d.ts"
  },
  "dependencies": {
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/server": "^11.11.0",
    "@emotion/styled": "^11.14.1",
