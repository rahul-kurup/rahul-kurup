{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "me",
  "main": "src/server.ts",
  "compatibility_date": "2026-08-04",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": true,
  "placement": { "mode": "smart" },
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true
    },
    "enabled": true,
    "head_sampling_rate": 1
  },
  "vars": {
    "MAIL_ACC_FROM": "ADD_IN_LOCAL_ENV",
    "MAIL_ACC_TO": "ADD_IN_CREATE_LOCAL_ENV",
    "RESEND_API_KEY": "ADD_IN_CREATE_LOCAL_ENV",
    "RECAPTCHA_SECRET_KEY": "ADD_IN_CREATE_LOCAL_ENV"
  },
  "env": {
    "production": {
      "routes": [
        {
          "pattern": "rahulkurup.com",
          "custom_domain": true
        }
      ]
    },
    "test": {
      "routes": [
        {
          "pattern": "dev.rahulkurup.com",
          "custom_domain": true
        }
      ]
    }
  }
}
